{% extends '@admin/layout.twig' %}
{% block title %}{{ t.redirects_log_title }} · {{ app.name }}{% endblock %}

{% block body %}
{% include '@redirects/_tabs.twig' with {tab: 'log'} %}

<div style="display:flex; gap:1rem; align-items:center; margin-bottom:1rem">
    {% if showIgnored %}
        <a href="{{ app.adminPath }}/redirects/404">{{ t.redirects_log_back }}</a>
    {% else %}
        <a href="{{ app.adminPath }}/redirects/404?ignored">{{ t.redirects_log_ignored }}</a>
        {% if isAdmin and entries is not empty %}
        <form method="post" action="{{ app.adminPath }}/redirects/404/clear" onsubmit="return confirm({{ t.redirects_log_clear_confirm|json_encode }})">
            <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
            <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
            <button type="submit" class="link danger">{{ t.redirects_log_clear }}</button>
        </form>
        {% endif %}
    {% endif %}
</div>

{% if entries is empty %}
    <p class="muted">{{ t.redirects_log_empty }}</p>
{% else %}
<table class="data-table redirects-table">
    <thead>
        <tr>
            <th>{{ t.redirects_log_th_path }}</th>
            <th>{{ t.redirects_log_th_hits }}</th>
            <th>{{ t.redirects_log_th_last }}</th>
            <th>{{ t.redirects_log_th_ref }}</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    {% for e in entries %}
        <tr>
            <td><code>{{ e.path }}</code></td>
            <td>{{ e.hits }}</td>
            <td class="muted">{{ e.last_seen|slice(0, 16)|replace({'T': ' '}) }}</td>
            <td class="muted" style="font-size:.8rem; word-break:break-all">{{ e.referrer }}</td>
            <td class="text-right" style="white-space:nowrap">
                {% if not showIgnored %}
                    <a href="{{ app.adminPath }}/redirects?from={{ e.path|url_encode }}#rule-form">{{ t.redirects_log_create }}</a>
                    &nbsp;
                {% endif %}
                <form method="post" action="{{ app.adminPath }}/redirects/404/ignore" style="display:inline">
                    <input type="hidden" name="{{ csrf.nameKey }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.valueKey }}" value="{{ csrf.value }}">
                    <input type="hidden" name="path" value="{{ e.path }}">
                    {% if showIgnored %}<input type="hidden" name="undo" value="1">{% endif %}
                    <button type="submit" class="link">{{ showIgnored ? t.redirects_log_unignore : t.redirects_log_ignore }}</button>
                </form>
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endif %}
{% endblock %}
