#!/usr/bin/env php
<?php

declare(strict_types=1);

$station0Root = dirname(__DIR__);

// Mirrors Bootstrap::findProjectRoot().
$projectRoot = (function (string $station0Root): string {
    // Real vendor install: vendor/lexislav/station0 → vendor/lexislav → vendor → project root
    if (basename(dirname($station0Root, 2)) === 'vendor') {
        return dirname($station0Root, 3);
    }
    // Symlinked dev install (__DIR__ is the real library path) or direct clone:
    // walk up from CWD to the first dir with vendor/ + composer.json.
    $dir = (string) getcwd();
    while ($dir !== '' && $dir !== dirname($dir)) {
        if (is_dir($dir . '/vendor') && is_file($dir . '/composer.json')) {
            return $dir;
        }
        $dir = dirname($dir);
    }
    return $station0Root;
})($station0Root);

require $projectRoot . '/vendor/autoload.php';

$dotenv = Dotenv\Dotenv::createImmutable($projectRoot);
$dotenv->safeLoad();

use Delight\Auth\Auth;
use Station0\Service\CollectionRepository;
use Station0\Service\ContentRepository;
use Station0\Service\FieldOptions;
use Station0\Service\FileCache;
use Station0\Service\MediaService;
use Station0\Service\TaskLauncher;
use Station0\Service\TaskRegistry;
use Station0\Service\ThumbService;
use Station0\Service\UserRepository;
use Symfony\Component\Yaml\Yaml;

$siteRoot = rtrim(getenv('SITE_PATH') ?: ($projectRoot . '/site'), '/');
$configFactory = require $siteRoot . '/config.php';
$config = $configFactory($station0Root, $siteRoot, $projectRoot);
$roles = require $station0Root . '/config/roles.php';

foreach ([$config['paths']['cache'], $config['paths']['sessions'], $config['paths']['logs'], $config['paths']['uploads']] as $dir) {
    if (!is_dir($dir)) {
        @mkdir($dir, 0775, true);
    }
}

$pdo = (function () use ($config) {
    $fresh = !file_exists($config['paths']['db']);
    $pdo = new \PDO('sqlite:' . $config['paths']['db']);
    $pdo->setAttribute(\PDO::ATTR_ERRMODE, \PDO::ERRMODE_EXCEPTION);
    if ($fresh) {
        $pdo->exec(file_get_contents($projectRoot . '/vendor/delight-im/auth/Database/SQLite.sql'));
    }
    return $pdo;
})();

ini_set('session.use_cookies', '0');
ini_set('session.use_only_cookies', '0');
ini_set('session.cache_limiter', '');
@session_start();

$auth = new Auth($pdo);
$users = new UserRepository($auth, $pdo, $roles);

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

switch ($command) {
    case 'user:create':
        [$username, $email, $role] = [$args[0] ?? null, $args[1] ?? null, $args[2] ?? 'editor'];
        if (!$username || !$email) {
            fwrite(STDERR, "Usage: bin/console user:create <username> <email> [role]\n");
            exit(1);
        }
        echo "Heslo pro {$username}: ";
        system('stty -echo');
        $pw = trim((string) fgets(STDIN));
        system('stty echo');
        echo "\n";
        if (strlen($pw) < 8) {
            fwrite(STDERR, "Heslo musí mít alespoň 8 znaků.\n");
            exit(1);
        }
        $id = $users->create($email, $pw, $role, $username);
        echo "Uživatel vytvořen (id={$id}, username={$username}, role={$role}).\n";
        break;

    case 'user:reset-password':
        $email = $args[0] ?? null;
        if (!$email) {
            fwrite(STDERR, "Usage: bin/console user:reset-password <email>\n");
            exit(1);
        }
        $stmt = $pdo->prepare('SELECT id FROM users WHERE email = :e');
        $stmt->execute([':e' => $email]);
        $id = (int) $stmt->fetchColumn();
        if (!$id) {
            fwrite(STDERR, "Uživatel {$email} neexistuje.\n");
            exit(1);
        }
        echo "Nové heslo: ";
        system('stty -echo');
        $pw = trim((string) fgets(STDIN));
        system('stty echo');
        echo "\n";
        if (strlen($pw) < 8) {
            fwrite(STDERR, "Heslo musí mít alespoň 8 znaků.\n");
            exit(1);
        }
        $users->setPassword($id, $pw);
        echo "Heslo změněno.\n";
        break;

    case 'cache:clear':
        $cache = new FileCache($config['paths']['cache']);
        $n = $cache->flush();
        echo "Smazáno {$n} položek cache.\n";
        break;

    case 'thumbs:clear':
        // public/thumb/ is only touched in static mode — never delete a web-root
        // directory the site might own for something else.
        $n = ThumbService::purge(
            $config['paths']['cache'],
            !empty($config['thumbs']['static']) ? \Station0\Bootstrap::publicDir($config) : null,
        );
        echo "Smazáno {$n} náhledů.\n";
        break;

    case 'thumbs:warm':
        // Renders every published page over HTTP (the server must be running)
        // and pre-generates each /thumb/... URL found in it, so the first
        // visitor does not wait for them.
        $baseUrl = rtrim($args[0] ?? $config['baseUrl'], '/');
        $repo    = new ContentRepository($config['paths']['content'] . '/pages');
        $thumbs  = \Station0\Bootstrap::thumbService(
            $config,
            new MediaService($repo, $config['paths']['content'] . '/pages', $config['paths']['content'] . '/collections'),
        );
        $done = 0;
        $failed = 0;
        foreach ($repo->all(false) as $page) {
            $url  = $baseUrl . implode('/', array_map('rawurlencode', explode('/', $page->urlPath)));
            $html = @file_get_contents($url);
            if ($html === false) {
                fwrite(STDERR, "  {$page->urlPath}: stránku nelze načíst ({$url})\n");
                continue;
            }
            preg_match_all('#/thumb/(\d+x\d+(?:-c)?)/([a-f0-9]{12})/([^"\'\s<>,]+)#u', $html, $m, PREG_SET_ORDER);
            $seen = [];
            foreach ($m as [$all, $spec, $sig, $path]) {
                if (isset($seen[$all])) {
                    continue;
                }
                $seen[$all] = true;
                $res = $thumbs->resolve($spec, $sig, rawurldecode(html_entity_decode($path)));
                ($res === null || $res['fallback']) ? $failed++ : $done++;
            }
            if ($seen) {
                echo "  {$page->urlPath}: " . count($seen) . " náhled(ů)\n";
            }
        }
        echo "Hotovo: {$done} náhledů připraveno" . ($failed ? ", {$failed} selhalo" : '') . ".\n";
        break;

    case 'assets:relink':
        $dryRun = in_array('--dry-run', $args, true);
        $repo   = new ContentRepository($config['paths']['content'] . '/pages');
        $changedFiles = 0;
        $changedRefs  = 0;

        foreach ($repo->all() as $page) {
            if (!$page->filePath || !is_file($page->filePath)) {
                continue;
            }
            $raw = (string) file_get_contents($page->filePath);
            // Split front matter from body — only the body holds asset references.
            $sep = strpos($raw, "\n---\n");
            if ($sep === false) {
                continue;
            }
            $head = substr($raw, 0, $sep + 5);
            $body = substr($raw, $sep + 5);

            // Local prefix to strip: /media/{page-url-path}/  (or /media/~/ for root)
            $prefix = $page->urlPath === '/'
                ? '/media/~/'
                : '/media' . rtrim($page->urlPath, '/') . '/';

            $count = 0;
            $newBody = preg_replace_callback(
                '#' . preg_quote($prefix, '#') . '([A-Za-z0-9._\-]+)#',
                function (array $m) use (&$count) { $count++; return $m[1]; },
                $body,
            ) ?? $body;

            if ($count === 0) {
                continue;
            }
            $changedFiles++;
            $changedRefs += $count;
            echo ($dryRun ? '[dry] ' : '') . "{$page->urlPath}: {$count} ref(s)\n";

            if (!$dryRun) {
                file_put_contents($page->filePath, $head . $newBody);
            }
        }

        echo ($dryRun ? '[dry] ' : '') . "Hotovo: {$changedRefs} reference(í) v {$changedFiles} stránk(ách).\n";
        if (!$dryRun && $changedFiles > 0) {
            (new FileCache($config['paths']['cache']))->flush();
        }
        break;

    case 'task:list':
    case 'task:run':
    case 'task:worker':
        $pages       = new ContentRepository($config['paths']['content'] . '/pages');
        $collections = new CollectionRepository($config['paths']['content'] . '/collections');
        $tasks = new TaskRegistry(
            $config['paths']['tasks'] ?? $siteRoot . '/tasks',
            $config['paths']['logs'] . '/tasks',
            $config,
            $pages,
            $collections,
            new FileCache($config['paths']['cache']),
            new FieldOptions($collections, $pages),
        );

        if ($command === 'task:worker') {
            // Internal: executes a queued background run (see TaskLauncher).
            $launcher = new TaskLauncher($tasks, $station0Root, $projectRoot, (array) ($config['tasks'] ?? []));
            $result   = $launcher->work((string) ($args[0] ?? ''));
            exit($result !== null && ($result['exit'] ?? 1) === 0 ? 0 : 1);
        }

        if ($command === 'task:list') {
            if ($tasks->all() === []) {
                echo "Žádné úlohy (site/tasks/*.php).\n";
                break;
            }
            foreach ($tasks->all() as $t) {
                printf("  %-24s %s%s%s\n", $t['name'], $t['label'],
                    $t['on'] !== [] ? '  [on: ' . implode(', ', $t['on']) . ']' : '',
                    $t['error'] !== null ? '  [CHYBA: ' . $t['error'] . ']' : '');
                foreach ($t['params'] as $p) {
                    printf("  %-24s   --%s%s  %s\n", '', $p['name'], $p['type'] === 'boolean' ? '' : '=<' . $p['type'] . '>', $p['label'] . (!empty($p['required']) ? ' (povinné)' : ''));
                }
            }
            break;
        }

        // task:run <name> [--param=value] [--flag]
        $name  = null;
        $input = [];
        foreach ($args as $arg) {
            if (preg_match('/^--([A-Za-z0-9_-]+)(?:=(.*))?$/s', $arg, $m)) {
                $input[$m[1]] = array_key_exists(2, $m) ? $m[2] : true;
            } elseif ($name === null) {
                $name = $arg;
            }
        }
        $task = $name !== null ? $tasks->find($name) : null;
        if ($task === null) {
            fwrite(STDERR, $name === null
                ? "Usage: bin/console task:run <name> [--param=value] [--flag]\n"
                : "Úloha '{$name}' neexistuje. Viz task:list.\n");
            exit(1);
        }
        ['values' => $values, 'errors' => $errors] = $tasks->resolveParams($task, $input);
        if ($errors !== []) {
            foreach ($errors as $param => $code) {
                fwrite(STDERR, "--{$param}: " . match ($code) {
                    'required' => 'povinný parametr',
                    'option'   => 'neplatná volba',
                    'file'     => 'soubor neexistuje',
                    default    => 'neplatná hodnota',
                } . "\n");
            }
            exit(1);
        }
        // Live output; STDOUT bypasses the output buffer the runner captures echo with.
        $result = $tasks->run($task, $values, 'cli', null, function (string $level, string $text) {
            fwrite($level === 'error' ? STDERR : STDOUT, ($level === 'warn' ? '[!] ' : '') . $text . "\n");
        });
        exit($result['exit'] === 0 ? 0 : max(1, min(255, (int) $result['exit'])));

    case 'help':
    default:
        echo "Station0 console\n";
        echo "  user:create <username> <email> [role]    Vytvoří uživatele (role: admin|editor)\n";
        echo "  user:reset-password <email>   Resetuje heslo\n";
        echo "  cache:clear                   Vyčistí cache obsahu\n";
        echo "  thumbs:clear                  Smaže vygenerované náhledy obrázků\n";
        echo "  thumbs:warm [baseUrl]         Předgeneruje náhledy všech publikovaných stránek (běžící server)\n";
        echo "  assets:relink [--dry-run]     Převede absolutní /media/... odkazy na page-local názvy\n";
        echo "  task:list                     Vypíše úlohy webu (site/tasks/*.php)\n";
        echo "  task:run <name> [--param=value]  Spustí úlohu webu\n";
        break;
}
